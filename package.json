{
  "name": "pi-coding-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "npm run types && wrangler deploy",
    "dev": "wrangler dev",
    "types": "wrangler types worker-configuration.d.ts --include-runtime=false",
    "check": "npm run types && tsc --noEmit",
    "test": "node --test tests/",
    "eval:calibrate": "node evals/fixtures/generate.mjs",
    "eval:core": "node evals/harness/run.mjs core",
    "eval:full": "node evals/harness/run.mjs full",
    "eval:rubric": "node evals/scorer/rubric-cli.mjs"
  },
  "dependencies": {
    "@cloudflare/sandbox": "1.0.0",
    "ajv": "^8.20.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "jest": "^29.7.0",
    "js-yaml": "^3.14.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "workerd@1.20261006.1": true,
    "esbuild@0.28.2": true
  }
}
